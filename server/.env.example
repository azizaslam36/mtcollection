# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local: mongodb://127.0.0.1:27017/mt-collection
# Atlas: mongodb+srv://<user>:<password>@<cluster>/mt-collection
MONGODB_URI=

# --- CORS ---
# Comma-separated list of allowed origins. In production this should
# be ONLY your deployed frontend URL, never "*".
FRONTEND_URL=http://localhost:3000

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=mt_admin_token

# --- Admin bootstrap ---
# Used only by `npm run seed` to create the first admin user if none
# exists yet. Change the password after first login if your admin UI
# supports it; otherwise re-run seed with a new value (see seed/seed.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo data ---
# Mirrors the frontend's NEXT_PUBLIC_SHOW_DEMO_DATA. Ignored entirely
# when NODE_ENV=production (demo data can never appear in production
# regardless of this value). Leave unset/false normally.
SHOW_DEMO_DATA=false

# --- Affiliate providers (optional) ---
# Leave blank to run in manual-entry-only mode (default, fully
# functional). See src/services/affiliate/README.md for details.
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
MYNTRA_AFFILIATE_ID=
MYNTRA_AFFILIATE_TOKEN=
