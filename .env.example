# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and should never be committed.

# Backend API base URL (see server/README or server/.env.example).
# Leave BLANK to run the frontend in local-data mode (Stage 1/2
# behavior — no backend needed, uses src/data/products & categories).
# Set it to enable Stage 3 database-driven mode, e.g.:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=

# Google Analytics 4 Measurement ID.
# The old static site had this hardcoded in every page's <head> as G-KFG6M3Y4P2.
# Move that same ID here instead of hardcoding it in components.
NEXT_PUBLIC_GA_ID=

# Controls whether mock/demo product & category data is included
# alongside real M&T Collection data. Defaults to true (shown) if unset.
# Set to "false" before production / client delivery to remove all
# demo data from the site in one step, with no code changes required.
NEXT_PUBLIC_SHOW_DEMO_DATA=true
mongodb+srv://<db_username>:nvoAhWLyzetsPxgQ@cluster0.wpvb7wc.mongodb.net/?appName=Cluster0